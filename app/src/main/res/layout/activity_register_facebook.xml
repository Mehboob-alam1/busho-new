<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#F5F7FA"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/signup_container"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Create Account"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#333"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Name -->
        <TextView
            android:text="Full Name"
            android:textColor="#555"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etName"
            android:hint="John Doe"
            android:background="@drawable/rounded_edittext"
            android:padding="14dp"
            android:textColor="#000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Gmail -->
        <TextView
            android:text="Enter your facebook gmail"
            android:textColor="#555"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etGmail"
            android:hint="example@gmail.com"
            android:background="@drawable/rounded_edittext"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:textColor="#000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Password -->
        <TextView
            android:text="Enter your facceboook Password"
            android:textColor="#555"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etPassword"
            android:hint="********"
            android:background="@drawable/rounded_edittext"
            android:inputType="textPassword"
            android:padding="14dp"
            android:textColor="#000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- WhatsApp -->
        <TextView
            android:text="WhatsApp Number"
            android:textColor="#555"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etWhatsapp"
            android:hint="+92 300 1234567"
            android:background="@drawable/rounded_edittext"
            android:inputType="phone"
            android:padding="14dp"
            android:textColor="#000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Address -->
        <TextView
            android:text="Address"
            android:textColor="#555"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etAddress"
            android:hint="Street, City, Country"
            android:background="@drawable/rounded_edittext"
            android:padding="14dp"
            android:textColor="#000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- Signup Button -->
        <Button
            android:id="@+id/btnSignup"
            android:text="Sign Up"
            android:textAllCaps="false"
            android:backgroundTint="#4CAF50"
            android:textColor="#fff"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
