{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid",
        "devices": {
          "$deviceId": {
            ".read": "auth.uid === $uid",
            ".write": "auth.uid === $uid",
            "files": {
              "$fileId": {
                ".validate": "newData.hasChildren(['fileId', 'name', 'category', 'uploadedAt'])",
                "fileId": { ".validate": "newData.isString()" },
                "name": { ".validate": "newData.isString()" },
                "mimeType": { ".validate": "newData.isString()" },
                "category": { ".validate": "newData.isString() && newData.val() in ['PDF', 'OFFICE', 'TEXT', 'IMAGE', 'WHATSAPP']" },
                "sizeBytes": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 104857600" },
                "storagePath": { ".validate": "newData.isString()" },
                "downloadUrl": { ".validate": "newData.isString()" },
                "uploadedAt": { ".validate": "newData.val() === now || newData.isNumber()" },
                "source": { ".validate": "newData.isString() && newData.val() in ['whatsapp', 'device']" },
                "device": { ".validate": "newData.isString()" }
              }
            }
          }
        }
      }
    },
    "library": {
      "files": {
        "$fileId": {
          ".read": "root.child('admins').child(auth.uid).exists()",
          ".write": "auth.uid !== null",
          ".validate": "newData.hasChildren(['userId', 'fileId', 'name', 'category'])",
          "userId": { ".validate": "newData.isString()" },
          "fileId": { ".validate": "newData.isString()" },
          "name": { ".validate": "newData.isString()" },
          "category": { ".validate": "newData.isString() && newData.val() in ['PDF', 'OFFICE', 'TEXT', 'IMAGE', 'WHATSAPP']" },
          "source": { ".validate": "newData.isString() && newData.val() in ['whatsapp', 'device']" },
          "downloadUrl": { ".validate": "newData.isString()" }
        }
      }
    },
    "admins": {
      ".read": "auth.uid !== null",
      ".write": false,
      "$uid": {
        ".validate": "newData.val() === true"
      }
    }
  }
}
