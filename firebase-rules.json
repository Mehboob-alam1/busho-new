{
  "rules": {
    "user_data": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('admins').child(auth.uid).exists() || auth.token.email === 'admin@bushorat.app')",
        ".write": "auth != null && auth.uid === $userId"
      }
    },
    "documents": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('admins').child(auth.uid).exists() || auth.token.email === 'admin@bushorat.app')",
        ".write": "auth != null && auth.uid === $userId",
        "$docId": {
          ".validate": "newData.hasChildren(['fileName', 'url'])"
        }
      }
    },
    "app_visibility": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('admins').child(auth.uid).exists() || auth.token.email === 'admin@bushorat.app')",
        ".write": "auth != null && (auth.uid === $userId || root.child('admins').child(auth.uid).exists() || auth.token.email === 'admin@bushorat.app')"
      }
    },
    "users": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('admins').child(auth.uid).exists() || auth.token.email === 'admin@bushorat.app')",
        ".write": "auth != null && auth.uid === $userId"
      }
    },
    "videos": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.email === 'admin@bushorat.app')",
      "$videoId": {
        ".validate": "newData.hasChildren(['title', 'videoUrl']) || newData.hasChildren(['title', 'url'])"
      }
    },
    "admins": {
      ".read": "auth != null",
      ".write": false,
      "$uid": {
        ".validate": "newData.val() === true"
      }
    }
  }
}
